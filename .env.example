# Sanitized environment-variable example for a new staging environment.
# Documentation/template only. Never commit real credentials.

HMS_ENV=staging
HMS_TIMEZONE=Asia/Kolkata
HMS_DB_HOST=replace_with_staging_database_host
HMS_DB_NAME=hms_staging
HMS_DB_USER=replace_with_least_privilege_staging_user
HMS_DB_PASSWORD=replace_with_secret_from_approved_secret_store

# Do not add API keys, SMTP passwords, production hostnames, patient data,
# private keys, or deployment tokens to this file.
